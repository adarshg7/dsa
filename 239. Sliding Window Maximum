class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {

        int max = Integer.MIN_VALUE;
        int idx = -1;

        for (int i = 0; i < k; i++) {
            if (nums[i] > max) {
                max = nums[i];
                idx = i;
            }
        }

        int[] arr = new int[nums.length - k + 1];
        arr[0] = max;

        for (int i = 1; i <= nums.length - k; i++) {

            int newElement = nums[i + k - 1];

            if (newElement > max) {
                max = newElement;
                idx = i + k - 1;
            }

            else if (idx < i) {

                max = Integer.MIN_VALUE;
                idx = -1;

                for (int j = i; j <= i + k - 1; j++) {
                    if (nums[j] > max) {
                        max = nums[j];
                        idx = j;
                    }
                }
            }

            arr[i] = max;
        }

        return arr;
    }
}
